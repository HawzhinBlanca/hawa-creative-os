{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@hawa/contracts": [
        "packages/contracts/dist/index.d.ts"
      ],
      "@hawa/domain": [
        "packages/domain/dist/index.d.ts"
      ],
      "@hawa/db": [
        "packages/db/dist/index.d.ts"
      ],
      "@hawa/retrieval": [
        "packages/retrieval/dist/index.d.ts"
      ],
      "@hawa/creative": [
        "packages/creative/dist/index.d.ts"
      ],
      "@hawa/qa": [
        "packages/qa/dist/index.d.ts"
      ],
      "@hawa/integrations": [
        "packages/integrations/dist/index.d.ts"
      ],
      "@hawa/observability": [
        "packages/observability/dist/index.d.ts"
      ],
      "@hawa/testkit": [
        "packages/testkit/dist/index.d.ts"
      ],
      "@hawa/evals": [
        "packages/evals/dist/index.d.ts"
      ]
    },
    "types": [
      "node",
      "vitest/globals"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/**/*.test.ts",
    "apps/**/*.spec.ts",
    "apps/**/test/**/*.ts",
    "packages/**/*.test.ts",
    "packages/**/*.spec.ts",
    "packages/**/test/**/*.ts",
    "packages/db/test-support/**/*.ts",
    "packages/testkit/chaos/**/*.ts",
    "scripts/test/**/*.ts",
    "apps/**/*.test.tsx",
    "apps/**/*.spec.tsx",
    "packages/**/*.test.tsx",
    "packages/**/*.spec.tsx",
    "scripts/**/*.test.ts",
    "scripts/**/*.spec.ts",
    "scripts/**/*.test.tsx",
    "scripts/**/*.spec.tsx"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "apps/desk/**"
  ]
}
