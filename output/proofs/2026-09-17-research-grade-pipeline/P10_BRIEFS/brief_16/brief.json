    },
    {
      "copyIndex": 1,
      "text": "بەڵگەنامەی نیشتمانیی دڵنیایی جۆری",
      "role": "title",
      "script": "arabic"
    },
    {
      "copyIndex": 2,
      "text": "بنەما سەرەکییەکانی پەروەردە و فێرکردن",
      "role": "subtitle",
      "script": "arabic"
    },
    {
      "copyIndex": 3,
      "text": "زانکۆ واژۆکارەکان پابەند دەبن بە ڕەچاوکردنی شەفافیەت، سەربەخۆیی زانستی، و پاراستنی مافی خوێندکاران.",
      "role": "body",
      "script": "arabic"
    },
    {
      "copyIndex": 4,
      "text": "دەستەی باڵای متمانەبەخشین • شاری هەولێر • ٢٠٢٦",
      "role": "footer",
      "script": "arabic"
    }
