# Copy to deployment/.env and fill secrets through the office secret-management process.
HAWA_DOMAIN=hawa.office.example
HAWA_BIND_IP=REPLACE_WITH_OFFICE_OR_TAILSCALE_IP
CADDY_ACME_EMAIL=admin@office.example

# All production images must be immutable image@sha256:... values.
CADDY_IMAGE=caddy:2.10.2@sha256:REPLACE_WITH_VERIFIED_DIGEST
POSTGRES_IMAGE=pgvector/pgvector:pg18@sha256:REPLACE_WITH_VERIFIED_DIGEST
RESTATE_IMAGE=restatedev/restate:1.7.0@sha256:REPLACE_WITH_VERIFIED_DIGEST
PHOENIX_IMAGE=arizephoenix/phoenix:REPLACE_WITH_PINNED_VERSION@sha256:REPLACE_WITH_VERIFIED_DIGEST
COMFYUI_IMAGE=office/comfyui:approved@sha256:REPLACE_WITH_VERIFIED_DIGEST
RETRIEVAL_IMAGE=office/qwen-vl-retrieval:approved@sha256:REPLACE_WITH_VERIFIED_DIGEST
WAHA_IMAGE=devlikeapro/waha:REPLACE_WITH_PINNED_VERSION@sha256:REPLACE_WITH_VERIFIED_DIGEST

HAWA_APP_VERSION=1.0.0
HAWA_DB_USER=hawa_app
HAWA_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DATABASE_URL=postgresql://hawa_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/hawa?sslmode=disable
POSTGRES_DB=postgres
POSTGRES_USER=hawa_owner
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SUPERUSER_SECRET
PG_SHARED_BUFFERS=2GB
PG_MAX_CONNECTIONS=100

HYCANVAS_VERSION=v0.3.9
HYCANVAS_DB_USER=hycanvas
HYCANVAS_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
HYCANVAS_DATABASE_URL=postgresql://hycanvas:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/hycanvas?sslmode=disable
HYCANVAS_JWT_SECRET=REPLACE_WITH_64_OR_MORE_RANDOM_BYTES
PHOENIX_DB_USER=phoenix
PHOENIX_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
PHOENIX_DATABASE_URL=postgresql://phoenix:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/phoenix?sslmode=disable

RESTATE_ADMIN_URL=http://restate:9070
RESTATE_INGRESS_URL=http://restate:8080
HYCANVAS_BASE_URL=http://hycanvas:8005
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces

OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=REPLACE.apps.googleusercontent.com
OIDC_CLIENT_SECRET=REPLACE
OIDC_ALLOWED_EMAIL_DOMAINS=office.example
SESSION_SECRET=REPLACE_WITH_64_OR_MORE_RANDOM_BYTES

TELEGRAM_BOT_TOKEN=REPLACE
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
WAHA_ENABLED=false
WAHA_BASE_URL=http://waha-adapter:3000
WAHA_SHARED_SECRET=REPLACE_IF_ENABLED

GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/google-service-account.json
GOOGLE_SHARED_DRIVE_ID=REPLACE_AFTER_CONFIGURATION
GOOGLE_REPORTING_SPREADSHEET_ID=REPLACE_AFTER_CONFIGURATION
GOOGLE_REPORTING_SHEET_ID=0

# Provider credentials remain server-side. Disable providers per client policy.
GOOGLE_AI_API_KEY=REPLACE_IF_ENABLED
OPENAI_API_KEY=REPLACE_IF_ENABLED
ANTHROPIC_API_KEY=REPLACE_IF_ENABLED
BFL_API_KEY=REPLACE_IF_ENABLED
RECRAFT_API_KEY=REPLACE_IF_ENABLED

BACKUP_REPOSITORY=s3:https://backup.example/hawa/restic
RESTIC_PASSWORD_FILE=/run/secrets/restic-password
PGBACKREST_STANZA=hawa
