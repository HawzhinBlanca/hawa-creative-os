{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hawa.local/schemas/Task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "clientId": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "projectId": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceMessageId": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 100000
    },
    "state": {
      "enum": [
        "received",
        "promotion_pending",
        "routing",
        "routing_review",
        "brief_draft",
        "brief_review",
        "context_ready",
        "design_planning",
        "asset_production",
        "studio_composition",
        "qa",
        "auto_repair",
        "human_review",
        "revision_requested",
        "approved",
        "publishing",
        "complete",
        "paused",
        "failed_retryable",
        "failed_operator",
        "cancelled"
      ]
    },
    "taskType": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        {
          "type": "null"
        }
      ]
    },
    "direction": {
      "enum": [
        "ltr",
        "rtl",
        "auto"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "sensitivity": {
      "enum": [
        "normal",
        "sensitive",
        "restricted"
      ]
    },
    "dueAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "tenantId",
    "title",
    "description",
    "state",
    "direction",
    "priority",
    "sensitivity",
    "version",
    "createdAt",
    "updatedAt"
  ]
}
