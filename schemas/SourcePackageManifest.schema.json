{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hawa.local/schemas/SourcePackageManifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "clientId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "designDocumentId": {
      "type": "string",
      "format": "uuid"
    },
    "designRevisionId": {
      "type": "string",
      "format": "uuid"
    },
    "studio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "schemaVersion",
        "sourceHash"
      ]
    },
    "briefHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "designPlanHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "clientDnaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(source|final|proof|qa|meta)/"
          },
          "kind": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "sourceRevisionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "path",
          "kind",
          "mimeType",
          "byteSize",
          "sha256",
          "sourceRevisionId"
        ]
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "family": {
            "type": "string"
          },
          "style": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "licenseRef": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "family",
          "style",
          "sha256"
        ]
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string"
          },
          "provenance": {
            "type": "object"
          }
        },
        "required": [
          "assetId",
          "sha256",
          "kind",
          "provenance"
        ]
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string"
          },
          "deploymentId": {
            "type": "string",
            "format": "uuid"
          },
          "requestHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "role",
          "deploymentId",
          "requestHash"
        ]
      }
    },
    "qcReportHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvalId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "packageHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "clientId",
    "designDocumentId",
    "designRevisionId",
    "studio",
    "briefHash",
    "designPlanHash",
    "clientDnaVersion",
    "files",
    "fonts",
    "assets",
    "models",
    "qcReportHash",
    "approvalId",
    "createdAt",
    "packageHash"
  ]
}
