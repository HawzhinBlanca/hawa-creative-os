{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hawa.local/schemas/ModelRegistry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "deployments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "exactModelId": {
            "type": "string"
          },
          "deploymentVersion": {
            "type": "string"
          },
          "admission": {
            "enum": [
              "candidate",
              "shadow",
              "canary",
              "primary",
              "fallback",
              "retired",
              "blocked"
            ]
          },
          "parameterProfile": {
            "type": "object"
          },
          "capabilities": {
            "type": "object"
          },
          "policy": {
            "type": "object"
          },
          "promptVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "fallbackRank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "evaluationRunId": {
            "oneOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "role",
          "provider",
          "exactModelId",
          "deploymentVersion",
          "admission",
          "parameterProfile",
          "capabilities",
          "policy"
        ]
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "revision",
    "deployments",
    "updatedAt",
    "contentHash"
  ]
}
