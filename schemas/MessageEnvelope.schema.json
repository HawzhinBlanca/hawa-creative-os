{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hawa.local/schemas/MessageEnvelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "hawa_desk",
            "telegram",
            "waha",
            "slack",
            "email",
            "other"
          ]
        },
        "integrationId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "integrationId",
        "version"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accountId": {
          "type": "string"
        },
        "channelId": {
          "type": "string"
        },
        "topicId": {
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "messageId": {
          "type": "string"
        },
        "revisionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "eventId": {
          "type": "string"
        },
        "sequence": {
          "type": [
            "string",
            "null"
          ]
        },
        "permalink": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      },
      "required": [
        "accountId",
        "channelId",
        "messageId",
        "eventId"
      ]
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalId": {
          "type": "string"
        },
        "mappedUserId": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "externalId"
      ]
    },
    "occurredAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        {
          "type": "null"
        }
      ]
    },
    "direction": {
      "enum": [
        "ltr",
        "rtl",
        "auto"
      ]
    },
    "text": {
      "type": "string",
      "maxLength": 200000
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "value": {}
        },
        "required": [
          "type"
        ]
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "filename": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "storageKey": {
            "type": "string"
          },
          "scanState": {
            "enum": [
              "pending",
              "clean",
              "quarantined",
              "rejected"
            ]
          }
        },
        "required": [
          "filename",
          "mimeType",
          "byteSize",
          "sha256",
          "storageKey",
          "scanState"
        ]
      }
    },
    "replyTo": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "messageId": {
              "type": "string"
            },
            "quotedText": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "messageId"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "actorExternalId": {
            "type": "string"
          },
          "action": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "actorExternalId"
        ]
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "method": {
          "type": "string"
        },
        "receivedIp": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "verified",
        "method"
      ]
    },
    "rawPayloadHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "adapter",
    "source",
    "sender",
    "receivedAt",
    "direction",
    "text",
    "attachments",
    "entities",
    "reactions",
    "verification",
    "rawPayloadHash"
  ]
}
