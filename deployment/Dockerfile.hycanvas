# The verified HyCanvas v0.3.9 binary must be placed at:
# deployment/vendor/hycanvas/hycanvas after verification against upstream SHA256SUMS.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10002 --create-home hycanvas
WORKDIR /opt/hycanvas
COPY --chmod=0755 vendor/hycanvas/hycanvas /usr/local/bin/hycanvas
RUN mkdir -p /var/lib/hycanvas/storage \
    && chown -R hycanvas:hycanvas /var/lib/hycanvas /opt/hycanvas
USER hycanvas
EXPOSE 8005
HEALTHCHECK --interval=15s --timeout=5s --retries=10 CMD wget -qO- http://127.0.0.1:8005/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/hycanvas"]
