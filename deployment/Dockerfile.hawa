# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm typecheck && pnpm test && pnpm build

FROM base AS runtime
ENV NODE_ENV=production
RUN useradd --system --uid 10001 --create-home hawa
WORKDIR /app
COPY --from=build --chown=hawa:hawa /app/dist ./dist
COPY --from=build --chown=hawa:hawa /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --prod --frozen-lockfile \
    && pnpm store prune
USER hawa
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD ["node", "dist/healthcheck.mjs"]
CMD ["node", "dist/server.mjs"]
