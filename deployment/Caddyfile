{
  admin off
  email {$CADDY_ACME_EMAIL}
  servers {
    trusted_proxies static private_ranges
  }
}

{$HAWA_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }

  @studio path /studio* /api/v1/studio-proxy*
  respond @studio "Local editor archived. Open your task in Canva." 410

  @api path /api* /auth* /events*
  handle @api {
    reverse_proxy app:3000
  }

  handle {
    reverse_proxy app:3000
  }

  log {
    output stdout
    # OAuth redirects carry one-time authorization codes and state in the query. Keep the
    # request/status evidence while removing those values from access logs.
    format filter {
      request>uri query {
        delete code
        delete state
      }
      wrap json
    }
  }
}
