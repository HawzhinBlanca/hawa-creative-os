                "schema": {
                  "type": "object",
                  "required": [
                    "commandId",
                    "taskId",
                    "acceptedAt",
                    "status",
                    "version",
                    "replayed"
                  ],
                  "properties": {
                    "commandId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "taskId": {
                      "type": "string",
                      "format": "uuid"
                    },
