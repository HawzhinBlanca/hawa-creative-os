        ],
        "responses": {
          "200": {
            "description": "Stored immutable export bytes, with X-Content-SHA256 and attachment disposition",
            "content": {
              "image/png": {},
              "application/pdf": {}
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role forbidden"
          },
          "409": {
            "description": "Scope, stale binding, pending operation, or reconnect required"
          },
          "422": {
            "description": "Invalid input or export content"
          },
          "502": {
            "description": "Provider or storage operation failed"
          },
          "503": {
            "description": "Database or configuration required"
          },
          "404": {
            "description": "No export for this task and actor"
          }
        },
        "security": [
          {
            "officeBearer": []
          }
        ]
      }
    },
    "/v1/tasks/{taskId}/canva/generate": {
      "post": {
        "operationId": "canvaCreateBlankDesign",
        "tags": [
          "Integrations"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
