{
  "openapi": "3.1.0",
  "info": {
    "title": "Hawa Canva Connect integration",
    "version": "0.1.0",
    "description": "Implemented API; live account admission pending. Retrieved exports are not QA-approved captures."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "officeBearer": []
    }
  ],
  "paths": {
    "/v1/integrations/canva/status": {
      "get": {
        "operationId": "canvaConnectionStatus",
        "tags": [
          "Integrations"
        ],
        "responses": {
          "200": {
            "description": "Operation result; no QA approval implied"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role forbidden"
          },
          "409": {
            "description": "Scope, stale binding, pending operation, or reconnect required"
          },
          "422": {
            "description": "Invalid input or export content"
          },
          "502": {
            "description": "Provider or storage operation failed"
          },
          "503": {
            "description": "Database or configuration required"
          }
        },
        "security": [
          {
            "officeBearer": []
          }
        ]
      }
    },
    "/v1/integrations/canva/authorize": {
