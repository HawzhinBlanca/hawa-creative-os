          "200": {
            "description": "Operation result; no QA approval implied"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role forbidden"
          },
          "409": {
            "description": "Scope, stale binding, pending operation, or reconnect required"
          },
          "422": {
            "description": "Invalid input or export content"
          },
          "502": {
            "description": "Provider or storage operation failed"
          },
          "503": {
            "description": "Database or configuration required"
          },
          "202": {
            "description": "Pending or uncertain operation; inspect status before retrying"
          },
          "201": {
            "description": "Native blank design created and bound"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 640,
                    "maximum": 2400
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 640,
                    "maximum": 2400
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "officeBearer": []
          }
        ],
        "summary": "Generate a draft with Claude Opus 5, retain exact-copy source, and import it into Canva; not a release approval"
      }
    },
    "/v1/tasks/{taskId}/canva/plans": {
      "get": {
        "summary": "Read durable planning status and actual provider usage receipts",
