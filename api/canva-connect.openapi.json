    "/v1/tasks/{taskId}/canva/artifacts/{artifactId}": {
      "get": {
        "operationId": "canvaDownloadExport",
        "tags": [
          "Integrations"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
