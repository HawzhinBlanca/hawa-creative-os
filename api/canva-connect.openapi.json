    "/v1/tasks/{taskId}/canva/exports": {
      "post": {
        "operationId": "canvaStartExport",
        "tags": [
          "Integrations"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            }
          },
          {
            "name": "X-Hawa-Manual-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "For current lifecycle manual revision preparation; required together with the expected request revision."
          },
          {
            "name": "X-Hawa-Manual-Request-Rev",
            "in": "header",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 2
            },
            "description": "Exact current request revision. Rechecked under the owner projection lock before preparation writes."
          }
        ],
        "responses": {
          "200": {
            "description": "Operation result; no QA approval implied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanvaExportResult"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role forbidden"
          },
          "409": {
            "description": "Scope, stale binding, pending operation, or reconnect required"
          },
          "422": {
            "description": "Invalid input or export content"
          },
          "502": {
            "description": "Provider or storage operation failed"
          },
          "503": {
            "description": "Database or configuration required"
          },
          "202": {
            "description": "Export operation result, possibly already retrieved; inspect status and the optional server review receipt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanvaExportResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "format",
                  "expectedVersion"
                ],
                "properties": {
                  "format": {
                    "enum": [
                      "png",
                      "pdf",
                      "pptx"
                    ]
                  },
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "description": "PNG supports one page only. PDF is standard, not print-qualified. Maximum retrieved file size 25 MiB."
              }
            }
          }
        },
        "security": [
          {
            "officeBearer": []
          }
        ],
        "description": "Retains export evidence. A retrieved checked PPTX can record a manual review when a PNG from the same Canva version is retained. Inspect the optional review receipt; missing or blocked review must not be presented as ready. No approval is created. Replay the same operation after an uncertain response. Checked PPTX admission freezes the matching imported source policy, or exact manual Desk copy with active human-authored Client DNA font families. Replay retains that original policy. Superseded manual policy cannot qualify new review, approval or publication; capture again using current Client DNA. For confirmed native revision handoffs, all formats freeze the current copy confirmation and Client DNA. Both PNG and PPTX must carry the latest confirmation identity before the pair can record review, even if their Canva update timestamps match older captures."
      }
    },
