    "/v1/integrations/canva/callback": {
      "get": {
        "operationId": "canvaCallback",
        "tags": [
          "Integrations"
        ],
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation result; no QA approval implied"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role forbidden"
          },
          "409": {
            "description": "Scope, stale binding, pending operation, or reconnect required"
          },
          "422": {
            "description": "Invalid input or export content"
          },
          "502": {
            "description": "Provider or storage operation failed"
          },
          "503": {
            "description": "Database or configuration required"
          },
          "400": {
            "description": "Invalid, expired, reused, declined or failed authorization"
          }
        },
        "security": [],
        "description": "Requires matching HttpOnly browser state cookie and unconsumed ten-minute database state. Success/failure are plain text; code/token values are never echoed."
      }
    },
