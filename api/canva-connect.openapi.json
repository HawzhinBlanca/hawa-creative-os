    "/v1/tasks/{taskId}/canva/design": {
      "post": {
        "operationId": "canvaCreateBlankDesign",
        "tags": [
          "Integrations"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation result; no QA approval implied"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role forbidden"
          },
          "409": {
            "description": "Scope, stale binding, pending operation, or reconnect required"
          },
          "422": {
            "description": "Invalid input or export content"
          },
          "502": {
            "description": "Provider or storage operation failed"
          },
          "503": {
            "description": "Database or configuration required"
          },
          "202": {
            "description": "Pending or uncertain operation; inspect status before retrying"
          },
          "201": {
            "description": "Native blank design created and bound"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "width",
                  "height"
                ],
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 40,
                    "maximum": 8000
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 40,
                    "maximum": 8000
                  }
                },
                "description": "Area must not exceed 25 million pixels. Creates blank editable canvas, not composed design."
              }
            }
          }
        },
        "security": [
          {
            "officeBearer": []
          }
        ]
      }
    },
    "/v1/tasks/{taskId}/canva/exports": {
      "post": {
        "operationId": "canvaStartExport",
        "tags": [
          "Integrations"
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation result; no QA approval implied"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role forbidden"
          },
          "409": {
            "description": "Scope, stale binding, pending operation, or reconnect required"
          },
          "422": {
            "description": "Invalid input or export content"
          },
          "502": {
            "description": "Provider or storage operation failed"
          },
          "503": {
            "description": "Database or configuration required"
          },
          "202": {
            "description": "Pending or uncertain operation; inspect status before retrying"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "format",
                  "expectedVersion"
                ],
                "properties": {
                  "format": {
                    "enum": [
                      "png",
                      "pdf",
                      "pptx"
                    ]
                  },
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "description": "PNG supports one page only. PDF is standard, not print-qualified. Maximum retrieved file size 25 MiB."
              }
            }
          }
        },
        "security": [
          {
            "officeBearer": []
          }
        ]
      }
    },
