# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
# Verdana is the client's Latin body face. The registry resolves it from
# /usr/share/fonts/truetype/msttcorefonts, which the Microsoft core-fonts package provides
# (its licence permits redistribution of the unmodified installer, which is what the Debian
# package fetches). Without it the studio has no admitted Latin body face and refuses every
# design with English copy, which is what production did from 2026-09-20 to 2026-09-22.
# webp-pixbuf-loader lets librsvg draw WebP: without it a WebP photo was blank in every preview and
# transparent in the Canva deck, while tests on a Mac (librsvg 2.62, WebP built in) passed (2026-09-24).
RUN sed -i 's/^Components: main$/Components: main contrib/' /etc/apt/sources.list.d/debian.sources \
    && echo 'ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true' | debconf-set-selections \
    && apt-get update \
    && apt-get install -y --no-install-recommends librsvg2-bin webp-pixbuf-loader fonts-dejavu-core cabextract ttf-mscorefonts-installer \
    && rm -rf /var/lib/apt/lists/* \
    && test -f /usr/share/fonts/truetype/msttcorefonts/Verdana.ttf
WORKDIR /app

FROM base AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config libpango1.0-dev && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY apps/core/package.json ./apps/core/
COPY apps/desk/package.json ./apps/desk/
COPY apps/worker/package.json ./apps/worker/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/domain/package.json ./packages/domain/
COPY packages/db/package.json ./packages/db/
COPY packages/integrations/package.json ./packages/integrations/
COPY packages/retrieval/package.json ./packages/retrieval/
COPY packages/creative/package.json ./packages/creative/
COPY packages/qa/package.json ./packages/qa/
COPY packages/observability/package.json ./packages/observability/
COPY packages/evals/package.json ./packages/evals/
COPY packages/testkit/package.json ./packages/testkit/

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY packages/ ./packages/
COPY apps/core/ ./apps/core/

RUN pnpm --filter @hawa/core... build

FROM base AS runner
ARG HAWA_BUILD_COMMIT=unknown
LABEL org.opencontainers.image.revision=$HAWA_BUILD_COMMIT
ENV NODE_ENV=production
ENV FONTCONFIG_FILE=/app/packages/creative/assets/fonts/fonts.conf
RUN useradd --system --uid 10001 --create-home hawa
WORKDIR /app

COPY --from=builder --chown=hawa:hawa /app/node_modules ./node_modules
COPY --from=builder --chown=hawa:hawa /app/packages ./packages
COPY --from=builder --chown=hawa:hawa /app/apps/core ./apps/core
COPY --from=builder --chown=hawa:hawa /app/package.json ./package.json
# Fixed evaluation inputs and source identity are runtime dependencies of durable replay.
COPY --chown=hawa:hawa evals/routing_brief.jsonl evals/retrieval_eval.jsonl evals/rtl_golden_cases.jsonl ./evals/
COPY --chown=hawa:hawa RELEASE_MANIFEST.json ./RELEASE_MANIFEST.json
RUN node --input-type=module -e "import { fixtureEvaluationIdentity } from './packages/evals/dist/fixture-replay.js'; if (!/^[0-9a-f]{64}$/.test(fixtureEvaluationIdentity().hash)) process.exit(1)"

# No second copy of the fonts under /usr/local/share/fonts: the renderer generates its own fontconfig
# file at run time (packages/creative/src/studio/font-environment.ts) listing only the repo's font
# folder and the Verdana files render-fonts.json names, so rsvg draws exactly the files fontkit
# measures. FONTCONFIG_FILE above lists the same set (the Verdana files are accepted by name and the
# rest of the system folders rejected), for fc-* tools and anything else that rasterises without the
# renderer's environment. fonts-dejavu-core stays installed for other tools only: the symbols copy may
# contain (☎ ✉ ➤ …) come from the committed HawaSymbols faces. Fail the build if a pinned Inter face
# is missing or variable again (a variable Inter was drawn ~7% narrower than measured), or the symbol
# faces are missing.
RUN test -f /app/packages/creative/assets/fonts/Inter-Regular.ttf \
    && test -f /app/packages/creative/assets/fonts/Inter-Bold.ttf \
    && test -f /app/packages/creative/assets/fonts/HawaSymbols-Regular.ttf \
    && test -f /app/packages/creative/assets/fonts/HawaSymbols-Bold.ttf \
    && ! fc-query -f '%{variable}\n' /app/packages/creative/assets/fonts/Inter-*.ttf | grep -q True

USER hawa
WORKDIR /app/apps/core
EXPOSE 3001
ENV PORT=3001

HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=5s \
  CMD node -e "fetch('http://localhost:3001/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "dist/index.js"]
