# Compose interpolation file for infra/docker/docker-compose.prod.yml.
# Copy to infra/docker/.env (gitignored). `docker compose` reads it for ${VAR} substitution;
# containers never see this file directly. Container variables live in .env.production.
#
# Owner password of the PostgreSQL data directory (postgres service).
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SUPERUSER_SECRET
# Runtime credential for core and worker: a login role, hawa_app_a or hawa_app_b, that inherits every
# grant of the NOLOGIN group role hawa_app. On an empty data directory 00-init-roles.sql creates both
# with this password. Afterwards never edit it by hand: infra/ops/rotate_app_role.sh gives the other
# login role a new password and install-env writes it here (runbook: infra/ops/README.md).
DATABASE_URL=postgresql://hawa_app_a:REPLACE_WITH_LONG_RANDOM_APP_ROLE_SECRET@postgres:5432/hawa
#
# Who asks Telegram for updates: the worker, always (ADR-135; deploy.sh refuses any other value, and
# Core no longer polls). HAWA_WORKER_TOKEN must be set in .env.production (infra/docker/README.md,
# "The Telegram poller"). HAWA_LIFECYCLE_CHATS no longer exists: every chat is lifecycle-owned.
HAWA_TELEGRAM_POLLER=worker
