# ==============================================================================
# Hawa Creative OS — Production Environment Configuration
# ==============================================================================

# Network & Host Binding
HAWA_DOMAIN=desk.hawa.office
HAWA_BIND_IP=127.0.0.1
HAWA_PORT=8080

# PostgreSQL 17 + pgvector
POSTGRES_DB=hawa
POSTGRES_USER=hawa_owner
POSTGRES_PASSWORD=replace_with_strong_production_password_entropy_64
PG_SHARED_BUFFERS=1GB
PG_MAX_CONNECTIONS=100

# Telegram Bot Ingress
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_high_entropy_webhook_secret_min_32_chars

# WAHA WhatsApp Bridge (Quarantined Ingress)
WAHA_ENDPOINT=http://127.0.0.1:3000
WAHA_API_KEY=replace_with_waha_key

# Google Drive & Sheets Integration
GOOGLE_SERVICE_ACCOUNT_KEY=REPLACE_WITH_SERVICE_ACCOUNT_JSON_ON_ONE_LINE
GOOGLE_SHARED_DRIVE_ID=drive_office_main
GOOGLE_SPREADSHEET_ID=sheet_tracker_prod

# Foundation Model Providers (Capability-Scoped & Budgeted)
GEMINI_API_KEY=replace_with_gemini_api_key
OPENAI_API_KEY=replace_with_openai_api_key
ANTHROPIC_API_KEY=replace_with_anthropic_api_key

# OpenTelemetry & Telemetry Collector
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces

# Canva Connect: configure locally, then authorize each Hawa operator in Settings.
# Never copy the Codex/ChatGPT connector token into this application.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
# A persistent, separately backed-up 32-byte key, encoded as 64 hexadecimal characters.
CANVA_TOKEN_ENCRYPTION_KEY=

# Telegram office policy. Director IDs may run /approve and /publish; intake IDs may submit briefs.
# Leave TELEGRAM_INTAKE_ALLOWED_USERS empty to accept briefs from the director list only.
# The value `*` opens intake to any Telegram user and must be a deliberate, documented decision.
TELEGRAM_ALLOWED_USERS=REPLACE_WITH_DIRECTOR_TELEGRAM_USER_ID
TELEGRAM_INTAKE_ALLOWED_USERS=
# Automatic Canva drafting for chat requests (paid model call per scoped request).
AUTO_GENERATE_CHAT_DESIGNS=false
# Daily ceilings for automatic drafts (each one is a paid model call plus a Canva import). Requests
# beyond the ceiling are still saved for the art director and the sender is told.
AUTO_GENERATE_DAILY_CAP_PER_SENDER=5
AUTO_GENERATE_DAILY_CAP_GLOBAL=200

# --- Office API credentials (rotate together; each must be long and random) ---
# ADR-146: trusted_office removes sign-in only for a trusted private office origin.
# Restore required before publishing customer access.
HAWA_DESK_AUTH_MODE=required
HAWA_TRUSTED_OFFICE_ORIGIN=http://127.0.0.1:8080
# Administrator key: Telegram delivery management, outbox requeue, provider configuration.
HAWA_ADMIN_KEY=REPLACE_WITH_LONG_RANDOM_ADMIN_KEY
# Art director / reviewer key: approvals in Hawa Desk.
HAWA_ART_DIRECTOR_KEY=REPLACE_WITH_LONG_RANDOM_REVIEWER_KEY
# Operator key; the worker also uses it to call Core (HAWA_BEARER_TOKEN).
HAWA_BEARER_TOKEN=REPLACE_WITH_LONG_RANDOM_OPERATOR_KEY
# The worker's own credential for Core's /v1/internal/* (Phase 2.1): long and random, and not equal to
# any other key here. Core and both worker colours read it. It must be set before HAWA_TELEGRAM_POLLER=worker
# (infra/docker/.env); without it the worker does not start its Telegram poller.
HAWA_WORKER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_WORKER_TOKEN
# HMAC secret for signed Telegram/WhatsApp action tokens. No default exists; unset means no actions.
HAWA_ACTION_HMAC_SECRET=REPLACE_WITH_LONG_RANDOM_HMAC_SECRET
# WhatsApp (WAHA) webhook secret; production refuses WhatsApp intake without it.
WAHA_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_WAHA_SECRET
# Public Desk address used in chat links (https recommended; a local address is sent as text only).
HAWA_PUBLIC_URL=http://127.0.0.1:8080
# Internal Core address the worker calls.
HAWA_CORE_INTERNAL_URL=http://core:3001

# Independent availability collector (ADR-104). Leave all three empty until configured.
# Use an independent Linux/macOS host and the exact office HTTPS origin, without a trailing slash.
HAWA_AVAILABILITY_MONITOR_ID=
HAWA_AVAILABILITY_TARGET_ORIGIN=
HAWA_AVAILABILITY_MONITOR_SECRET=
