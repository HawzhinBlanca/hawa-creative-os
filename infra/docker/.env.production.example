# ==============================================================================
# Hawa Creative OS — Production Environment Configuration
# ==============================================================================

# Network & Host Binding
# HAWA_DOMAIN is read by nothing (ADR-159); it may be removed. HAWA_PUBLIC_URL below names the Desk.
HAWA_DOMAIN=desk.hawa.office
HAWA_BIND_IP=127.0.0.1
HAWA_PORT=8080

# PostgreSQL 17 + pgvector
POSTGRES_DB=hawa
POSTGRES_USER=hawa_owner
POSTGRES_PASSWORD=replace_with_strong_production_password_entropy_64
PG_SHARED_BUFFERS=1GB
PG_MAX_CONNECTIONS=100

# Telegram Bot Ingress
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_high_entropy_webhook_secret_min_32_chars

# WAHA WhatsApp Bridge (Quarantined Ingress)
WAHA_ENDPOINT=http://127.0.0.1:3000
WAHA_API_KEY=replace_with_waha_key

# Google Drive & Sheets Integration
GOOGLE_SERVICE_ACCOUNT_KEY=REPLACE_WITH_SERVICE_ACCOUNT_JSON_ON_ONE_LINE
# Read by nothing (ADR-159): each client's Drive folder and sheet come from its client DNA. Removable.
GOOGLE_SHARED_DRIVE_ID=drive_office_main
GOOGLE_SPREADSHEET_ID=sheet_tracker_prod

# Foundation Model Providers (Capability-Scoped & Budgeted)
GEMINI_API_KEY=replace_with_gemini_api_key
OPENAI_API_KEY=replace_with_openai_api_key
ANTHROPIC_API_KEY=replace_with_anthropic_api_key

# OpenTelemetry & Telemetry Collector. PHOENIX_COLLECTOR_URL is accepted too (ADR-159). Only the
# integrations health report reads it: the Phoenix client exports no spans yet, and production runs
# no Phoenix container, so it may be removed until a collector exists.
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces

# Canva Connect: configure locally, then authorize each Hawa operator in Settings.
# Never copy the Codex/ChatGPT connector token into this application.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
# A persistent, separately backed-up 32-byte key, encoded as 64 hexadecimal characters.
CANVA_TOKEN_ENCRYPTION_KEY=

# Telegram office policy. Director IDs may run /approve and /publish; intake IDs may submit briefs.
# Leave TELEGRAM_INTAKE_ALLOWED_USERS empty to accept briefs from the director list only.
# The value `*` opens intake to any Telegram user and must be a deliberate, documented decision.
TELEGRAM_ALLOWED_USERS=REPLACE_WITH_DIRECTOR_TELEGRAM_USER_ID
TELEGRAM_INTAKE_ALLOWED_USERS=
# ADR-200: before an office member's approval in Telegram sends a draft to someone else, the bot asks
# once, "Send <title> to <requester> now?", and a plain yes sends it. On unless `off`; off, approval
# words that are certain send at once (an approval whose words or draft are not certain is still asked).
HAWA_OFFICE_CONFIRM_SEND=on
# Automatic Canva drafting for chat requests, Telegram and WhatsApp (a paid model call and a Canva
# import per scoped request). Only `true` drafts; anything else saves every chat request for the art
# director. Telegram ignored it until ADR-159; the office runs with true.
AUTO_GENERATE_CHAT_DESIGNS=false
# Daily ceilings for automatic drafts (each one is a paid model call plus a Canva import). Requests
# beyond the ceiling are still saved for the art director and the sender is told.
AUTO_GENERATE_DAILY_CAP_PER_SENDER=5
AUTO_GENERATE_DAILY_CAP_GLOBAL=200
# The nightly live canary (ADR-240, scripts/live_canary.ts). HAWA_CANARY_CHAT_ID must be a whole number
# from 4503599627370496 to 9007199254740991, a range no Telegram chat can have; any other value is
# ignored. TelegramSender records what is addressed to it, and every office alert about its requests,
# instead of sending them. Add the same id to TELEGRAM_INTAKE_ALLOWED_USERS so its briefs are taken.
# HAWA_CANARY_AUTOMATIC_DESIGNS_PER_WEEK (0 to 7, default 0): automatic, paid designs the canary chat
# may start in any six and a half days; 0 makes all its requests a designer's (no paid call), 1 one real
# round every seventh night. The canary client and its name are read by the canary script only; left
# empty they are the shipped "Canary Test" client (ADR-254, c1000000-0000-4000-8000-000000000099, an
# onboarding pack: it is never designed for automatically, so its nights are all unpaid).
HAWA_CANARY_CHAT_ID=
HAWA_CANARY_AUTOMATIC_DESIGNS_PER_WEEK=0
HAWA_CANARY_CLIENT_ID=
HAWA_CANARY_CLIENT_NAME=
# The v3 design pipeline. DESIGN_PIPELINE_V3=on runs it for every chat; otherwise only the chats listed
# in DESIGN_PIPELINE_V3_CHATS (comma-separated Telegram chat ids) run it, the rest the default path.
# /v1/health shows flags.DESIGN_PIPELINE_V3 and, as a count, how many chats the list enrols (never
# the ids), so "off" with a count above 0 means v3 runs for those chats (ADR-158).
DESIGN_PIPELINE_V3=off
DESIGN_PIPELINE_V3_CHATS=
# The scheduled paid health probe (one small paid model call every HAWA_BILLING_PROBE_MINUTES, 30).
# Off unless `on`; /v1/health then reports the model provider "disabled", which is not degraded.
HAWA_BILLING_PROBE_ENABLED=

# --- Office API credentials (rotate together; each must be long and random) ---
# ADR-146: trusted_office removes sign-in only for a trusted private office origin.
# Restore required before publishing customer access.
HAWA_DESK_AUTH_MODE=required
HAWA_TRUSTED_OFFICE_ORIGIN=http://127.0.0.1:8080
# Administrator key: Telegram delivery management, outbox requeue, provider configuration.
HAWA_ADMIN_KEY=REPLACE_WITH_LONG_RANDOM_ADMIN_KEY
# Art director / reviewer key: approvals in Hawa Desk.
HAWA_ART_DIRECTOR_KEY=REPLACE_WITH_LONG_RANDOM_REVIEWER_KEY
# Legacy operator key adopted as the scoped design-worker credential by ADR-163.
# Kept for previous-Core rollback compatibility; current Core denies this key office/list/admin access.
HAWA_BEARER_TOKEN=REPLACE_WITH_LONG_RANDOM_OPERATOR_KEY
# The worker's own credential for Core's /v1/internal/* (Phase 2.1): long and random, and not equal to
# any other key here. Core and both worker colours read it. It must be set before HAWA_TELEGRAM_POLLER=worker
# (infra/docker/.env); without it the worker does not start its Telegram poller.
HAWA_WORKER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_WORKER_TOKEN
# HMAC secret for signed Telegram/WhatsApp action tokens. No default exists; unset means no actions.
HAWA_ACTION_HMAC_SECRET=REPLACE_WITH_LONG_RANDOM_HMAC_SECRET
# WhatsApp (WAHA) webhook secret; production refuses WhatsApp intake without it.
WAHA_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_WAHA_SECRET
# Public Desk address used in chat links (https recommended; a local address is sent as text only).
HAWA_PUBLIC_URL=http://127.0.0.1:8080
# Internal Core address the worker calls.
HAWA_CORE_INTERNAL_URL=http://core:3001

# Independent availability collector (ADR-104). Leave all three empty until configured.
# Use an independent Linux/macOS host and the exact office HTTPS origin, without a trailing slash.
HAWA_AVAILABILITY_MONITOR_ID=
HAWA_AVAILABILITY_TARGET_ORIGIN=
HAWA_AVAILABILITY_MONITOR_SECRET=

# --- Removable (ADR-159, audit 2026-09-30) ---
# Production's .env.production still carries these; nothing in this release reads them:
#   KAAE_CANVA_DESIGN_ID, KAAE_CANVA_EDIT_URL, KAAE_CANVA_TEMPLATE_URL, KAAE_GOOGLE_SHARED_DRIVE_ID,
#   KAAE_SPREADSHEET_ID (the v1 KAAE templates were retired, ADR-038);
#   FIGMA_BUZZ_ENABLED, FIGMA_CLOUD_RELAY, FIGMA_DEFAULT_FILE_KEY, FIGMA_FILE_KEY, HAWA_FIGMA_BRIDGE_URL
#   (the Figma transport was decommissioned, ADR-021);
#   HAWA_LIFECYCLE_CHATS (every chat is lifecycle-owned since ADR-135; while it is set Core logs an
#   error at every start).
# Remove them from .env.production at the next deploy; keep HAWA_LIFECYCLE_CHATS only while a
# rollback to a release before ADR-135 stage 2 is still possible (infra/docker/README.md).
