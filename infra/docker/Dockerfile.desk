# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS builder
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY apps/desk/package.json ./apps/desk/
COPY apps/core/package.json ./apps/core/
COPY apps/worker/package.json ./apps/worker/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/domain/package.json ./packages/domain/
COPY packages/db/package.json ./packages/db/
COPY packages/integrations/package.json ./packages/integrations/
COPY packages/retrieval/package.json ./packages/retrieval/
COPY packages/creative/package.json ./packages/creative/
COPY packages/qa/package.json ./packages/qa/
COPY packages/observability/package.json ./packages/observability/
COPY packages/evals/package.json ./packages/evals/
COPY packages/testkit/package.json ./packages/testkit/

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY packages/ ./packages/
COPY apps/desk/ ./apps/desk/

RUN chmod -R a+rX apps/desk/public/assets || true
RUN pnpm --filter @hawa/desk build

FROM nginx:1.27-alpine-slim AS runner
ARG HAWA_BUILD_COMMIT=unknown
LABEL org.opencontainers.image.revision=$HAWA_BUILD_COMMIT
COPY --from=builder /app/apps/desk/dist /usr/share/nginx/html
RUN chmod -R a+rX /usr/share/nginx/html/assets || true
COPY infra/docker/nginx-desk.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
