# Developer environment. Production uses deployment/env.example and a secret store.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hawa_owner:REPLACE_WITH_LOCAL_DEV_PASSWORD@localhost:5432/hawa
RESTATE_ADMIN_URL=http://localhost:9070
RESTATE_INGRESS_URL=http://localhost:8080
HYCANVAS_BASE_URL=http://localhost:8005
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
STAGING_ROOT=.local/staging
AUTH_DEV_USER_EMAIL=developer@office.local
TELEGRAM_ENABLED=false
WAHA_ENABLED=false
MODEL_FAKE_MODE=true
