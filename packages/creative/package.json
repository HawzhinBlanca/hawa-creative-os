{
  "name": "@hawa/creative",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm build:native && tsc && node -e \"require('node:fs').copyFileSync('src/studio/pricing.json','dist/studio/pricing.json')\"",
