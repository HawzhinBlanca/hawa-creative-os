    "@hawa/domain": "workspace:*",
    "@hawa/integrations": "workspace:*",
    "fontkit": "^2.0.4",
    "pngjs": "^7.0.0",
    "pptxgenjs": "4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/pngjs": "^6.0.5",
    "fflate": "0.8.3"
  }
