# Test database credentials for `pnpm test`. Copy to `.env.test` (gitignored; chmod 600) and fill in.
# The plain suite uses hawa_test. The five hawa_repair suites run only when HAWA_ISOLATED_TEST_DB is
# set (owner role) with HAWA_ISOLATED_RUNTIME_DB (app role); provision hawa_repair with
#   POSTGRES_ADMIN_URL=<owner url to /postgres> npx tsx packages/db/src/provision-isolated-test-db.ts
# CI supplies the same variables from its secret store. Nothing here is read by production.
TEST_DATABASE_URL=postgresql://hawa_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:54332/hawa_test
TEST_DATABASE_OWNER_URL=postgresql://hawa_owner:REPLACE_WITH_OWNER_PASSWORD@127.0.0.1:54332/hawa_test
#HAWA_ISOLATED_TEST_DB=postgresql://hawa_owner:REPLACE_WITH_OWNER_PASSWORD@127.0.0.1:54332/hawa_repair
#HAWA_ISOLATED_RUNTIME_DB=postgresql://hawa_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:54332/hawa_repair
