# Test database credentials for `pnpm test`. Copy to `.env.test` (gitignored; chmod 600) and fill in.
# The databases live on the test suite's own server, hawa-test-postgres on 127.0.0.1:55432, never
# on the production server (54332): vitest refuses to start if any of these reaches port 54332 or
# the `hawa` database. `pnpm test:db` starts and provisions it (hawa_test and hawa_repair), and
# `pnpm test:db --print-env` prints these four lines with this machine's test passwords filled in.
# The five hawa_repair suites run only when HAWA_ISOLATED_TEST_DB and HAWA_ISOLATED_RUNTIME_DB are set.
# CI supplies the same variables from its secret store. Nothing here is read by production.
TEST_DATABASE_URL=postgresql://hawa_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:55432/hawa_test
TEST_DATABASE_OWNER_URL=postgresql://hawa_owner:REPLACE_WITH_OWNER_PASSWORD@127.0.0.1:55432/hawa_test
HAWA_ISOLATED_TEST_DB=postgresql://hawa_owner:REPLACE_WITH_OWNER_PASSWORD@127.0.0.1:55432/hawa_repair
HAWA_ISOLATED_RUNTIME_DB=postgresql://hawa_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:55432/hawa_repair
